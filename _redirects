# Writing is hidden until there is a post to show (removed 2026-11-09; its URL
# was on LinkedIn, so send it home rather than to a 404). Delete both rules and
# restore the nav, footer and homepage links when the first new post goes up.
/writing/i-filtered-for-bad-websites/*  /  301
/writing/*  /  302
/writing  /  302

# The audit checker's tests, helper modules and backend notes are repo files,
# not site pages.
/tests/*            /404.html  404
/functions/*        /404.html  404
/AUDIT-BACKEND.md   /404.html  404

# Shareable audit reports: every /check/{id} is served by one page, which reads
# the report from /api/check/{id}.
/check/*  /check/index.html  200
